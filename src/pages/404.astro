---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PrimaryButton from "../components/ui/PrimaryButton.astro";
---

<BaseLayout title="Page Not Found | APEXQUANTS" robots="noindex, nofollow">
	<Nav />
	<main class="notfound">
		<div class="notfound-inner">
			<span class="font-mono-label" style="color: var(--accent);">
				◆&nbsp; ERROR 404
			</span>
			<h1>Page not found</h1>
			<p>The page you're looking for doesn't exist or has moved.</p>
			<PrimaryButton href="/">Return Home</PrimaryButton>
		</div>
	</main>
	<Footer />
</BaseLayout>

<style>
	.notfound {
		position: relative;
		z-index: 2;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 1.5rem 5rem;
	}
	.notfound-inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		width: 100%;
		max-width: 48rem;
	}
	.notfound h1 {
		font-size: clamp(2.5rem, 7vw, 5rem);
	}
	.notfound p {
		color: var(--text-muted);
	}
</style>
