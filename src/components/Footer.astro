---
import BrandDivider from "./ui/BrandDivider.astro";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-top">
            <!-- Brand column -->
            <div class="footer-brand">
                <a
                    href="/"
                    class="footer-logo-link"
                    aria-label="Apex Quants LLP Home"
                >
                    <svg
                        class="header-logo-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--accent)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m3 21 8-18 8 18"></path>
                        <path d="M5 14h14"></path>
                        <circle cx="12" cy="6" r="2" fill="var(--accent)"
                        ></circle>
                    </svg>
                    <span class="footer-wordmark">APEX QUANTS LLP</span>
                </a>
                <p class="footer-tagline">
                    Crafting Code. Engineering Excellence. Elevating Businesses.
                </p>
            </div>

            <!-- Links columns -->
            <div class="footer-links-grid">
                <!-- Services -->
                <div class="footer-col">
                    <h4 class="footer-heading">Services</h4>
                    <ul class="footer-list">
                        <li><a href="#services">Core Technology</a></li>
                        <li><a href="#quant">Quantitative Engineering</a></li>
                        <li><a href="#services">AI &amp; ML</a></li>
                        <li><a href="#services">Cloud &amp; DevOps</a></li>
                    </ul>
                </div>

                <!-- Company -->
                <div class="footer-col">
                    <h4 class="footer-heading">Company</h4>
                    <ul class="footer-list">
                        <li><a href="#about">About</a></li>
                        <li><a href="#why-us">Why Us</a></li>
                        <li><a href="#industries">Industries</a></li>
                        <li><a href="#contact">Contact</a></li>
                    </ul>
                </div>

                <!-- Connect -->
                <div class="footer-col">
                    <h4 class="footer-heading">Connect</h4>
                    <ul class="footer-list">
                        <li>
                            <a href="mailto:info@apexquants.com"
                                >info@apexquants.com</a>
                        </li>
                        <li>
                            <span class="footer-text-link"
                                >+91 986-772-4923</span>
                        </li>
                        <li>
                            <a
                                href="https://linkedin.com"
                                target="_blank"
                                rel="noopener noreferrer">LinkedIn</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Brand Divider -->
        <div class="footer-divider-wrapper">
            <BrandDivider />
        </div>

        <!-- Bottom -->
        <div class="footer-bottom">
            <p class="copyright">
                &copy; 2025 APEX QUANTS LLP. All Rights Reserved.
            </p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: #050505; /* Slightly lighter than pure black as spec */
        padding: 6rem 1.5rem 2rem;
        position: relative;
        z-index: 10;
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Footer Top (Brand + Links Grid) ──────────────────────── */
    .footer-top {
        display: flex;
        justify-content: space-between;
        gap: 4rem;
        margin-bottom: 4rem;
    }

    /* ── Brand Column ───────────────────────────────────────── */
    .footer-brand {
        max-width: 320px;
    }

    .footer-logo-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        margin-bottom: 1rem;
    }

    .footer-wordmark {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
        color: var(--text-primary);
    }

    .footer-tagline {
        font-family: var(--font-body);
        font-size: 0.875rem;
        line-height: 1.6;
        color: #cccccc;
        max-width: 280px;
    }

    /* ── Links Grid ─────────────────────────────────────────── */
    .footer-links-grid {
        display: flex;
        gap: 5rem;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-heading {
        font-family: var(--font-display); /* Syne */
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .footer-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .footer-list a,
    .footer-text-link {
        font-family: var(--font-body); /* DM Sans */
        font-size: 0.875rem;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer-list a:hover {
        color: var(--accent);
    }

    /* ── Divider Wrapper ────────────────────────────────────── */
    .footer-divider-wrapper {
        margin-bottom: 1.5rem;
        /* Adjust BrandDivider padding if necessary */
    }

    /* ── Footer Bottom ──────────────────────────────────────── */
    .footer-bottom {
        display: flex;
        justify-content: center;
        text-align: center;
    }

    .copyright {
        font-family: var(--font-mono); /* JetBrains Mono/mono */
        font-size: 0.75rem;
        color: #cccccc;
        letter-spacing: 0.02em;
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .footer-top {
            flex-direction: column;
            gap: 3rem;
        }

        .footer-links-grid {
            gap: 3rem;
            justify-content: space-between;
        }
    }

    @media (max-width: 640px) {
        .site-footer {
            padding: 4rem 1.25rem 2rem;
        }

        .footer-top {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 3rem;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .footer-links-grid {
            flex-direction: column;
            align-items: center;
            gap: 2.5rem;
            width: 100%;
        }

        .footer-col {
            align-items: center;
        }

        .footer-tagline {
            margin: 0 auto;
        }
    }
</style>
