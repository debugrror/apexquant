---
import BrandDivider from "./ui/BrandDivider.astro";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-top">
            <!-- Brand column -->
            <div class="footer-brand">
                <a
                    href="/"
                    class="footer-logo-link"
                    aria-label="APEX QUANTS LLP — Home"
                >
                    <img src="/images/logo.png" alt="" width="32" height="32" style="object-fit:contain" />
                    <span class="footer-wordmark brand-name">APEX QUANTS LLP</span>
                </a>
                <p class="footer-tagline">
                    Quantitative engineering for capital markets.
                </p>
            </div>

            <!-- Links columns -->
            <div class="footer-links-grid">
                <!-- Services -->
                <div class="footer-col">
                    <p class="footer-heading">Services</p>
                    <ul class="footer-list">
                        <li><a href="/#services">Core Technology</a></li>
                        <li><a href="/#quant">Quantitative Engineering</a></li>
                        <li><a href="/#services">AI &amp; ML</a></li>
                        <li><a href="/#services">Cloud &amp; DevOps</a></li>
                    </ul>
                </div>

                <!-- Company -->
                <div class="footer-col">
                    <p class="footer-heading">Company</p>
                    <ul class="footer-list">
                        <li><a href="/#about">About</a></li>
                        <li><a href="/#why-us">Why Us</a></li>
                        <li><a href="/#industries">Industries</a></li>
                        <li><a href="/#contact">Contact</a></li>
                    </ul>
                </div>

                <!-- Connect -->
                <div class="footer-col">
                    <p class="footer-heading">Connect</p>
                    <ul class="footer-list">
                        <li>
                            <a href="mailto:info@apexquants.com"
                                >info@apexquants.com</a>
                        </li>
                        <li>
                            <a href="tel:+919867724923">+91 98677 24923</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Brand Divider -->
        <div class="footer-divider-wrapper">
            <BrandDivider />
        </div>

        <!-- Bottom -->
        <div class="footer-bottom">
            <p class="copyright">
                &copy; {new Date().getFullYear()} APEX QUANTS LLP. All Rights Reserved.
            </p>
            <p class="disclaimer">
                APEX QUANTS LLP provides technology and engineering services.
                Nothing on this site constitutes investment advice.
            </p>
            <a href="/privacy/" class="footer-legal-link">Privacy Policy</a>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: #050505; /* Slightly lighter than pure black as spec */
        padding: 6rem 1.5rem 2rem;
        position: relative;
        z-index: 10;
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Footer Top (Brand + Links Grid) ──────────────────────── */
    .footer-top {
        display: flex;
        justify-content: space-between;
        gap: 4rem;
        margin-bottom: 4rem;
    }

    /* ── Brand Column ───────────────────────────────────────── */
    .footer-brand {
        max-width: 320px;
    }

    .footer-logo-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        margin-bottom: 1rem;
    }

    .footer-wordmark {
        font-size: 0.9375rem;
        color: var(--accent);
        letter-spacing: 0.05em;
    }

    .footer-tagline {
        font-family: var(--font-body);
        font-size: 0.875rem;
        line-height: 1.6;
        color: #cccccc;
        max-width: 280px;
    }

    /* ── Links Grid ─────────────────────────────────────────── */
    .footer-links-grid {
        display: flex;
        gap: 5rem;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-heading {
        font-family: var(--font-display); /* Barlow Condensed */
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .footer-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .footer-list a,
    .footer-text-link {
        font-family: var(--font-body); /* Barlow */
        font-size: 0.875rem;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer-list a:hover {
        color: var(--accent);
    }

    /* ── Divider Wrapper ────────────────────────────────────── */
    .footer-divider-wrapper {
        margin-bottom: 1.5rem;
        /* Adjust BrandDivider padding if necessary */
    }

    /* ── Footer Bottom ──────────────────────────────────────── */
    .footer-bottom {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
    }

    .disclaimer {
        font-family: var(--font-body);
        font-size: 0.75rem;
        line-height: 1.5;
        color: #8a8a8a;
        max-width: 60ch;
    }

    .footer-legal-link {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .footer-legal-link:hover {
        color: var(--accent);
    }

    .copyright {
        font-family: var(--font-mono); /* JetBrains Mono/mono */
        font-size: 0.75rem;
        color: #cccccc;
        letter-spacing: 0.02em;
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .footer-top {
            flex-direction: column;
            gap: 3rem;
        }

        .footer-links-grid {
            gap: 3rem;
            justify-content: space-between;
        }
    }

    @media (max-width: 640px) {
        .site-footer {
            padding: 4rem 1.25rem 2rem;
        }

        .footer-top {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 3rem;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .footer-links-grid {
            flex-direction: column;
            align-items: center;
            gap: 2.5rem;
            width: 100%;
        }

        .footer-col {
            align-items: center;
        }

        .footer-tagline {
            margin: 0 auto;
        }
    }
</style>
