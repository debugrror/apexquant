---
import BrandDivider from "./ui/BrandDivider.astro";

const services = [
    {
        num: "01",
        name: "Algorithmic Trading Development",
        description:
            "End-to-end strategy engineering for Equities, Futures, Forex, and Cryptocurrency markets. From signal generation to live order routing — we architect the complete execution stack.",
    },
    {
        num: "02",
        name: "High-Frequency & Low-Latency Architecture",
        description:
            "Co-location-ready trading infrastructure engineered for sub-millisecond execution. We optimise at every layer: kernel bypass networking, lock-free data structures, and hardware-aware code paths.",
    },
    {
        num: "03",
        name: "Quantitative Research & Signal Development",
        description:
            "Rigorous alpha research frameworks: factor model construction, statistical signal validation, walk-forward testing, and backtesting engines designed to avoid look-ahead bias and overfitting.",
    },
    {
        num: "04",
        name: "Statistical Arbitrage & Market Neutrality",
        description:
            "Pairs trading, cointegration strategies, and cross-asset statistical arbitrage. Systems that identify and trade structural pricing inefficiencies while holding market-neutral risk exposures.",
    },
    {
        num: "05",
        name: "Portfolio Construction & Risk Modelling",
        description:
            "Monte Carlo simulation, VaR and CVaR risk attribution, factor decomposition, and drawdown control systems. Applied consistently across multi-asset portfolios.",
    },
    {
        num: "06",
        name: "Execution Algorithms",
        description:
            "Smart order routing with TWAP, VWAP, Implementation Shortfall, and Arrival Price algorithms. Designed to minimise market impact and slippage during large position builds or liquidations.",
    },
    {
        num: "07",
        name: "Market Analysis & Forecasting",
        description:
            "Machine Learning-based regime detection (Hidden Markov Models, clustering approaches), volatility forecasting, and factor-based return prediction models with live production deployment pipelines.",
    },
];
---

<section class="quant-services" id="quant">
    <div class="quant-inner">
        <!-- Header block -->
        <div class="quant-header anim-quant-header">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; 03 — QUANTITATIVE ENGINEERING
            </span>

            <h2 class="quant-headline">
                Institutional-Grade Quantitative Infrastructure
            </h2>

            <p class="quant-intro">
                Our Quantitative Engineering practice serves capital market
                participants who need mathematical rigour, execution
                precision, and system reliability beyond what off-the-shelf
                platforms provide. Each component is designed for the latency,
                throughput, and failure modes of professional trading.
            </p>
        </div>

        <!-- Numbered service list -->
        <div class="quant-list">
            {
                services.map((service, i) => (
                    <div
                        class="quant-item anim-quant-item"
                        style={`transition-delay: ${0.1 * i}s;`}
                    >
                        <div class="quant-item-left">
                            <span class="quant-num">{service.num}.</span>
                            <h3 class="quant-name">{service.name}</h3>
                        </div>
                        <p class="quant-desc">{service.description}</p>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Brand divider -->
    <BrandDivider />
</section>

<!-- Scroll-triggered staggered slide-in -->
<script>
    const quantSection = document.getElementById("quant");
    if (quantSection) {
        const targets = quantSection.querySelectorAll(
            ".anim-quant-header, .anim-quant-item",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .quant-services {
        position: relative;
        padding: 7rem 1.5rem 0;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .quant-inner {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Header block ───────────────────────────────────────── */
    .quant-header {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 780px;
        margin-bottom: 3rem;
    }

    .quant-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
    }

    .quant-intro {
        color: var(--text-muted);
        font-size: 1.0625rem;
        line-height: 1.7;
        max-width: 700px;
    }

    /* ── Numbered service list ──────────────────────────────── */
    .quant-list {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
    }

    .quant-item {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: baseline;
        padding: 2rem 0;
        border-bottom: 1px solid rgba(168, 255, 0, 0.12);
    }

    .quant-item:first-child {
        border-top: 1px solid rgba(168, 255, 0, 0.12);
    }

    .quant-item-left {
        display: flex;
        align-items: baseline;
        gap: 1.25rem;
    }

    .quant-num {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.5rem, 4vw, 4rem);
        color: var(--accent);
        opacity: 0.4;
        line-height: 1;
        flex-shrink: 0;
        min-width: 4.5rem;
    }

    .quant-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1rem, 1.5vw, 1.25rem);
        letter-spacing: -0.01em;
        line-height: 1.25;
        color: var(--text-primary);
    }

    .quant-desc {
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 1.65;
    }

    /* ── Scroll animations ──────────────────────────────────── */
    .anim-quant-header {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 0.7s ease-out,
            transform 0.7s ease-out;
    }

    .anim-quant-item {
        opacity: 0;
        transform: translateX(-30px);
        transition:
            opacity 0.5s ease-out,
            transform 0.5s ease-out;
    }

    .anim-quant-header.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .anim-quant-item.visible {
        opacity: 1;
        transform: translateX(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 768px) {
        .quant-services {
            padding: 5rem 1.25rem 0;
        }

        .quant-item {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        .quant-num {
            font-size: clamp(2rem, 10vw, 2.5rem);
            min-width: 3rem;
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-quant-header,
        .anim-quant-item {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
