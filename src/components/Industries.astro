            </div>

            <!-- Quantitative Research Labs -->
            <div
                class="industry-tile anim-ind-tile"
                style="animation-delay: 0.25s;"
            >
                <div class="tile-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
