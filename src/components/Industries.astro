                style="animation-delay: 0s;"
            >
                <div class="tile-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"
                        ></polyline>
                        <polyline points="16 7 22 7 22 13"></polyline>
                    </svg>
                </div>
                <span class="tile-label"
                    >Hedge Funds &amp; Prop Trading Desks</span
                >
            </div>

            <!-- Fintech Startups & Scaleups -->
            <div
                class="industry-tile anim-ind-tile"
                style="animation-delay: 0.05s;"
            >
                <div class="tile-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                    </svg>
                </div>
                <span class="tile-label">Fintech Startups &amp; Scaleups</span>
            </div>

            <!-- Asset Management Firms -->
            <div
                class="industry-tile anim-ind-tile"
                style="animation-delay: 0.1s;"
            >
                <div class="tile-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"
                        ></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
                        ></path>
                    </svg>
                </div>
                <span class="tile-label">Asset Management Firms</span>
            </div>

            <!-- Crypto & Digital Asset Platforms -->
            <div
                class="industry-tile anim-ind-tile"
                style="animation-delay: 0.15s;"
            >
                <div class="tile-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <span class="tile-label"
                    >Crypto &amp; Digital Asset Platforms</span
