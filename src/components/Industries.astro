<section class="industries" id="industries">
    <div class="industries-inner">
        <!-- Decorative section number -->
        <span class="section-number" aria-hidden="true">05</span>

        <!-- Header -->
        <div class="industries-header anim-ind-header">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; INDUSTRIES SERVED
            </span>

            <h2 class="industries-headline">
                Engineering for the Firms That Cannot Afford to Fail
