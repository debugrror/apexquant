                <span class="tile-label">Quantitative Research Labs</span>
            </div>
        </div>
    </div>
</section>

<!-- Scroll animation -->
<script>
    const indSection = document.getElementById("industries");
    if (indSection) {
        const targets = indSection.querySelectorAll(
            ".anim-ind-header, .anim-ind-tile",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.15 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .industries {
        position: relative;
        padding: 5rem 1.5rem 5rem;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .industries-inner {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Decorative section number ──────────────────────────── */
    .section-number {
        position: absolute;
        top: -1.5rem;
        left: -0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(6rem, 12vw, 10rem);
        color: #1a1a1a;
        line-height: 1;
        letter-spacing: -0.04em;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    /* ── Header ─────────────────────────────────────────────── */
    .industries-header {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .industries-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--text-primary);
        max-width: 640px;
    }

    /* ── Industry tiles grid ────────────────────────────────── */
    .industries-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    /* ── Individual tile ────────────────────────────────────── */
    .industry-tile {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 1.25rem 1.75rem;
        border: 1px solid #2a2a2a;
        background: transparent;
        border-radius: 0;
        transition:
            border-color 0.3s ease,
            background-color 0.3s ease;
        cursor: default;
    }

    .industry-tile:hover {
        border-color: var(--accent);
        background: var(--bg-card);
    }

    .tile-icon {
        color: var(--accent);
        width: 22px;
        height: 22px;
        flex-shrink: 0;
    }

    .tile-label {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9375rem;
        letter-spacing: -0.01em;
        line-height: 1.3;
        color: var(--text-primary);
        white-space: nowrap;
    }

    /* ── Scroll animations ──────────────────────────────────── */
    .anim-ind-header {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }

    .anim-ind-header.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .anim-ind-tile {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.5s ease-out,
            transform 0.5s ease-out,
            border-color 0.3s ease,
            background-color 0.3s ease;
    }

    .anim-ind-tile.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 900px) {
        .industries-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .tile-label {
            white-space: normal;
        }
    }

    @media (max-width: 480px) {
        .industries {
            padding: 4rem 1.25rem 4rem;
        }

        .industries-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .industry-tile {
            padding: 1rem 1.25rem;
        }

        .tile-label {
            font-size: 0.8125rem;
        }

        .section-number {
            font-size: clamp(4rem, 20vw, 6rem);
            top: -1rem;
            left: -0.25rem;
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-ind-header,
        .anim-ind-tile {
            opacity: 1 !important;
            transform: none !important;
            transition:
                border-color 0.3s ease,
                background-color 0.3s ease !important;
        }
    }
</style>
