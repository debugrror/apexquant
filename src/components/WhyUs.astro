---
import BrandDivider from "./ui/BrandDivider.astro";
---

<section class="why-us" id="why-us">
    <div class="why-us-inner">
        <!-- Decorative section number -->
        <span class="section-number" aria-hidden="true">04</span>

        <!-- Header -->
        <div class="why-us-header anim-why-header">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; WHY APEX QUANTS
            </span>

            <h2 class="why-us-headline">
                Why Leading Firms Choose <span class="brand-name"
                    >APEX QUANTS LLP</span
                >
            </h2>

            <!-- Subtle glow accent dot -->
            <div class="glow-dot" aria-hidden="true"></div>
        </div>

        <!-- 2×2 Pillars Grid -->
        <div class="pillars-grid">
            <!-- Pillar 1 — Quant-Native Expertise -->
            <div class="pillar anim-pillar" style="animation-delay: 0s;">
                <div class="pillar-icon" aria-hidden="true">
                    <!-- Brain / Neural icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path
                            d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"
                        ></path>
                        <path
                            d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"
                        ></path>
                    </svg>
                </div>
                <h3 class="pillar-heading">Quant-Native Expertise</h3>
                <p class="pillar-body">
                    Our team thinks in volatility surfaces and execution
                    shortfall before writing a single line of code. This
                    domain-depth means we identify edge cases and system
                    requirements that technology generalists miss entirely.
                </p>
            </div>

            <!-- Pillar 2 — Security-First Architecture -->
            <div class="pillar anim-pillar" style="animation-delay: 0.1s;">
                <div class="pillar-icon" aria-hidden="true">
                    <!-- Shield-check icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                        ></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
                <h3 class="pillar-heading">Security-First Architecture</h3>
                <p class="pillar-body">
                    Every system we deliver is designed assuming adversarial
                    conditions. Security is never retrofitted — it is part of
                    our initial architecture review, threat modelling, and code
                    review process.
                </p>
            </div>

            <!-- Pillar 3 — Cloud-Native Scalability -->
            <div class="pillar anim-pillar" style="animation-delay: 0.2s;">
                <div class="pillar-icon" aria-hidden="true">
                    <!-- Server / Scale icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="20" height="8" x="2" y="2" rx="2" ry="2"
                        ></rect>
                        <rect width="20" height="8" x="2" y="14" rx="2" ry="2"
                        ></rect>
                        <line x1="6" x2="6.01" y1="6" y2="6"></line>
                        <line x1="6" x2="6.01" y1="18" y2="18"></line>
                    </svg>
                </div>
                <h3 class="pillar-heading">Cloud-Native Scalability</h3>
                <p class="pillar-body">
                    We architect for the order of magnitude beyond your current
                    requirement. Systems built on auto-scaling infrastructure
                    with observability baked in — so growth never becomes an
                    emergency.
                </p>
            </div>

            <!-- Pillar 4 — Automation-Driven Efficiency -->
            <div class="pillar anim-pillar" style="animation-delay: 0.3s;">
                <div class="pillar-icon" aria-hidden="true">
                    <!-- Workflow / Automation icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="8" height="8" x="3" y="3" rx="2"></rect>
                        <path d="M7 11v4a2 2 0 0 0 2 2h4"></path>
                        <rect width="8" height="8" x="13" y="13" rx="2"></rect>
                    </svg>
                </div>
                <h3 class="pillar-heading">Automation-Driven Efficiency</h3>
                <p class="pillar-body">
                    From CI/CD pipelines to AI agent workflows, we
                    systematically identify and eliminate manual operational
                    overhead — compounding engineering velocity over the
                    lifetime of the engagement.
                </p>
            </div>
        </div>
    </div>

    <!-- Brand divider -->
    <BrandDivider />
</section>

<!-- Scroll-triggered stagger animation -->
<script>
    const whySection = document.getElementById("why-us");
    if (whySection) {
        const targets = whySection.querySelectorAll(
            ".anim-why-header, .anim-pillar",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.15 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .why-us {
        position: relative;
        padding: 7rem 1.5rem 0;
        background: var(--bg-card); /* #0D0D0D — slight lift from pure black */
        overflow: hidden;
    }

    .why-us-inner {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Decorative section number ──────────────────────────── */
    .section-number {
        position: absolute;
        top: -1.5rem;
        left: -0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(6rem, 12vw, 10rem);
        color: #1a1a1a;
        line-height: 1;
        letter-spacing: -0.04em;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    /* ── Header ─────────────────────────────────────────────── */
    .why-us-header {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 720px;
        margin-bottom: 4rem;
    }

    .why-us-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
    }

    .why-us-headline .brand-name {
        font-size: inherit;
        color: var(--text-primary);
    }

    /* Subtle neon green glow dot near heading */
    .glow-dot {
        position: absolute;
        top: 0.5rem;
        left: -1.5rem;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow:
            0 0 8px rgba(168, 255, 0, 0.6),
            0 0 20px rgba(168, 255, 0, 0.3),
            0 0 40px rgba(168, 255, 0, 0.15);
    }

    /* ── 2×2 Pillars Grid ───────────────────────────────────── */
    .pillars-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3.5rem 4rem;
    }

    /* ── Individual pillar ──────────────────────────────────── */
    .pillar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        /* No borders — whitespace is the separator */
    }

    .pillar-icon {
        color: var(--accent);
        width: 48px;
        height: 48px;
        flex-shrink: 0;
    }

    .pillar-heading {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.375rem;
        letter-spacing: -0.01em;
        line-height: 1.2;
        color: var(--text-primary);
    }

    .pillar-body {
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 1.7;
        max-width: 480px;
    }

    /* ── Scroll animations ──────────────────────────────────── */
    .anim-why-header {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 0.7s ease-out,
            transform 0.7s ease-out;
    }

    .anim-why-header.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .anim-pillar {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }

    .anim-pillar.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 768px) {
        .why-us {
            padding: 5rem 1.25rem 0;
        }

        .pillars-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .section-number {
            font-size: clamp(4rem, 20vw, 6rem);
            top: -1rem;
            left: -0.25rem;
        }

        .glow-dot {
            display: none;
        }

        .why-us-header {
            margin-bottom: 3rem;
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-why-header,
        .anim-pillar {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
