---
import BrandDivider from "./ui/BrandDivider.astro";
import StatCounter from "./ui/StatCounter.astro";
import PrimaryButton from "./ui/PrimaryButton.astro";
import GhostButton from "./ui/GhostButton.astro";

const stats = [
    { value: "50", suffix: "+", prefix: "", label: "Systems Architected" },
    { value: "99.9", suffix: "%", prefix: "", label: "Uptime SLA Delivered" },
    { value: "5", suffix: "ms", prefix: "<", label: "Latency Benchmarks Hit" },
    {
        value: "12",
        suffix: "+",
        prefix: "",
        label: "Quant Strategies Deployed",
    },
];
---

<section class="hero" id="hero">
    <!-- Background layers -->
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="dot-grid-overlay" aria-hidden="true"></div>

    <!-- Right Side 3D Volatility Surface -->
    <div class="hero-3d-surface" id="hero-3d-surface"></div>

    <!-- Hero Content -->
    <div class="hero-content">
        <!-- Eyebrow -->
        <div class="hero-eyebrow anim-eyebrow">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; QUANTITATIVE ENGINEERING FIRM &nbsp;◆
            </span>
        </div>

        <!-- H1 -->
        <h1 class="hero-h1">
            <span class="anim-h1-line-1">We Engineer the</span>
            <span class="anim-h1-line-2">Systems That Power</span>
            <span class="anim-h1-line-3">
                Capital Markets<span class="accent-dot">.</span>
            </span>
        </h1>

        <!-- Subheading -->
        <p class="hero-subheading anim-subheading">
            <span class="brand-name">APEX QUANTS LLP</span> architects high-performance
            algorithmic trading infrastructure, AI-driven financial platforms, and
            enterprise cloud systems — built for the precision demands of hedge funds,
            fintech firms, and capital market operators.
        </p>

        <!-- CTA Row -->
        <div class="hero-cta-row anim-cta">
            <PrimaryButton href="#services"
                >→ Explore Our Services</PrimaryButton
            >
            <GhostButton href="#contact">Schedule a Discovery Call</GhostButton>
        </div>

        <!-- Brand Divider -->
        <BrandDivider />

        <!-- Stat Strip -->
        <div class="hero-stats" id="hero-stats">
            {
                stats.map((stat, i) => (
                    <StatCounter
                        value={stat.value}
                        suffix={stat.suffix}
                        prefix={stat.prefix}
                        label={stat.label}
                        index={i}
                    />
                ))
            }
        </div>
    </div>
</section>

<!-- Stat Counter Animation (IntersectionObserver) -->
<script>
    function animateCounter(
        el: HTMLElement,
        target: number,
        suffix: string,
        prefix: string,
    ) {
        const counterSpan = el.querySelector(".counter") as HTMLElement;
        if (!counterSpan) return;

        const duration = 1800;
        const startTime = performance.now();
        const hasDecimal = target % 1 !== 0;

        function update(currentTime: number) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // ease-out cubic
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = eased * target;

            counterSpan.textContent = hasDecimal
                ? current.toFixed(1)
                : Math.floor(current).toString();

            if (progress < 1) {
                requestAnimationFrame(update);
            } else {
                counterSpan.textContent = hasDecimal
                    ? target.toFixed(1)
                    : target.toString();
            }
        }

        requestAnimationFrame(update);
    }

    const statsContainer = document.getElementById("hero-stats");
    if (statsContainer) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const cards =
                            statsContainer.querySelectorAll(".anim-stat");
                        cards.forEach((card, i) => {
                            const el = card as HTMLElement;
                            const value = parseFloat(
                                el.dataset.statValue || "0",
                            );
                            const suffix = el.dataset.statSuffix || "";
                            const prefix = el.dataset.statPrefix || "";

                            setTimeout(() => {
                                el.classList.add("visible");
                                animateCounter(el, value, suffix, prefix);
                            }, i * 150);
                        });
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.2 },
        );
        observer.observe(statsContainer);
    }
</script>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 8rem 1.5rem 4rem;
        overflow: hidden;
    }

    /* CSS Background — radial gradient method */
    .hero-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 80% 60% at 60% 40%,
                rgba(168, 255, 0, 0.04) 0%,
                transparent 70%
            ),
            radial-gradient(
                ellipse 50% 40% at 20% 70%,
                rgba(168, 255, 0, 0.03) 0%,
                transparent 60%
            ),
            #000000;
        z-index: 0;
    }

    /* 3D Surface Container */
    .hero-3d-surface {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 45vw;
        height: 70vh;
        z-index: 5;
        pointer-events: auto; /* Enable hover events for pause */
    }

    /* Hero Content */
    .hero-content {
        position: relative;
        z-index: 10;
        max-width: 780px;
        width: 100%;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-left: clamp(2rem, 8vw, 10rem);
    }

    /* Eyebrow */
    .hero-eyebrow {
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    /* H1 */
    .hero-h1 {
        display: flex;
        flex-direction: column;
        font-weight: 700;
        font-size: clamp(2.8rem, 5.5vw, 4.5rem);
        letter-spacing: -0.02em;
        line-height: 1;
        margin-bottom: 1.75rem;
        text-transform: none;
    }

    .hero-h1 span {
        display: block;
        white-space: nowrap;
    }

    .accent-dot {
        color: var(--accent);
    }

    /* Subheading */
    .hero-subheading {
        color: var(--text-muted);
        max-width: 560px;
        margin-bottom: 2.5rem;
        font-size: 1.0625rem;
        line-height: 1.7;
        text-align: left;
    }

    .hero-subheading .brand-name {
        color: var(--text-primary);
        font-size: inherit;
    }

    /* CTA Row */
    .hero-cta-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    /* Stat Strip */
    .hero-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        width: 100%;
        max-width: 780px;
    }

    /* ── Mobile & Tablet ────────────────── */
    @media (max-width: 1023px) {
        .hero-3d-surface {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .hero {
            padding: 7rem 1.25rem 3rem;
            min-height: auto;
            justify-content: flex-start;
        }

        .hero-content {
            margin-left: 0;
        }

        .hero-h1 {
            font-size: clamp(2.2rem, 9vw, 3rem);
        }

        .hero-h1 span {
            white-space: normal;
        }

        .hero-subheading {
            font-size: 0.9375rem;
            max-width: 100%;
        }

        .hero-cta-row {
            flex-direction: column;
            width: 100%;
        }

        .hero-cta-row :global(a) {
            width: 100%;
        }

        .hero-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<!-- 3D Volatility Surface Script -->
<script type="module" is:inline>
    import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

    function initVolSurface() {
        const container = document.getElementById("hero-3d-surface");
        if (!container) return;

        // Dimensions
        let cw = container.clientWidth || window.innerWidth * 0.45;
        let ch = container.clientHeight || window.innerHeight * 0.7;

        const scene = new THREE.Scene();

        // Camera
        const camera = new THREE.PerspectiveCamera(45, cw / ch, 0.1, 100);
        // Position camera to look down at the surface
        camera.position.set(13, 10, 13);
        camera.lookAt(0, 0, 0);

        // Renderer
        const renderer = new THREE.WebGLRenderer({
            alpha: true,
            antialias: true,
        });
        renderer.setSize(cw, ch);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        /* ── Geometry ── */
        // Plane runs from -5 to 5 on X and Y
        const segmentsX = 40;
        const segmentsY = 40;
        const geometry = new THREE.PlaneGeometry(10, 10, segmentsX, segmentsY);

        const pos = geometry.attributes.position;
        const zValues = new Float32Array(pos.count);
        let minZ = Infinity;
        let maxZ = -Infinity;

        // Calculate volatility for each point
        for (let i = 0; i < pos.count; i++) {
            const x = pos.getX(i); // -5 to 5 -> Moneyness
            const y = pos.getY(i); // -5 to 5 -> Expiry

            // Normalise X (Moneyness): -1 (put wing) to 1 (call wing)
            const m = x / 5;

            // Normalise Y (Time to Expiry): 0.1 to 2.0
            // Since plane Y is applied to global -Z, y=-5 is front (short tte), y=5 is back (long tte)
            const t = 0.1 + ((y + 5) / 10) * 1.9;

            // Volatility formula components
            const baseVol = 0.2 + 0.1 / Math.sqrt(t);
            const smile = (0.8 / Math.sqrt(t)) * (m * m);
            const skew = (-0.2 / Math.sqrt(t)) * m; // Put skew (higher on left)

            const z = baseVol + smile + skew;
            zValues[i] = z;

            if (z < minZ) minZ = z;
            if (z > maxZ) maxZ = z;
        }

        // Apply heights and colors
        const colors = new Float32Array(pos.count * 3);
        // Low vol color: subtle #A8FF00 at 5%
        const colorLow = new THREE.Color(
            (168 / 255) * 0.05,
            (255 / 255) * 0.05,
            0,
        );
        // High vol color: stronger #A8FF00 at 15%
        const colorHigh = new THREE.Color(
            (168 / 255) * 0.15,
            (255 / 255) * 0.15,
            0,
        );
        const tempColor = new THREE.Color();

        for (let i = 0; i < pos.count; i++) {
            const z = zValues[i];

            // Scale Z so surface looks physically balanced (approx 0 to 4 range)
            const normalizedZ = (z - minZ) / (maxZ - minZ);
            const displayZ = normalizedZ * 4 - 1;

            pos.setZ(i, displayZ);

            // Interpolate color based on height
            tempColor.copy(colorLow).lerp(colorHigh, normalizedZ);
            colors[i * 3] = tempColor.r;
            colors[i * 3 + 1] = tempColor.g;
            colors[i * 3 + 2] = tempColor.b;
        }

        geometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));
        geometry.computeVertexNormals();

        /* ── Materials ── */
        // 1. Transparent face fill using additive blending
        const surfaceMat = new THREE.MeshBasicMaterial({
            vertexColors: true,
            transparent: true,
            blending: THREE.AdditiveBlending,
            side: THREE.DoubleSide,
            depthWrite: false,
        });
        const surfaceMesh = new THREE.Mesh(geometry, surfaceMat);
        // Rotate plane so Z becomes vertical height
        surfaceMesh.rotation.x = -Math.PI / 2;

        // 2. Wireframe lines
        const wireMat = new THREE.MeshBasicMaterial({
            color: 0xa8ff00,
            wireframe: true,
            transparent: true,
            opacity: 0.5,
            side: THREE.DoubleSide,
        });
        const wireMesh = new THREE.Mesh(geometry, wireMat);
        wireMesh.rotation.x = -Math.PI / 2;

        /* ── Axis Helper (Visual purely, not labeled) ── */
        // Box outline for technical feel
        const boxGeom = new THREE.BoxGeometry(10, 4, 10);
        const boxEdges = new THREE.EdgesGeometry(boxGeom);
        const boxMat = new THREE.LineBasicMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.2,
        });
        const boxLines = new THREE.LineSegments(boxEdges, boxMat);
        boxLines.position.y = 1; // Center height to match surface

        // Group everything
        const surfaceGroup = new THREE.Group();
        surfaceGroup.add(surfaceMesh);
        surfaceGroup.add(wireMesh);
        surfaceGroup.add(boxLines);
        // Tilt slightly for better view
        surfaceGroup.rotation.x = 0.1;
        scene.add(surfaceGroup);

        /* ── Animation & Interaction ── */
        const clock = new THREE.Clock();
        let isHovered = false;

        container.addEventListener("mouseenter", () => (isHovered = true));
        container.addEventListener("mouseleave", () => (isHovered = false));

        let animId;
        function animate() {
            animId = requestAnimationFrame(animate);
            const delta = Math.min(clock.getDelta(), 0.1); // Cap delta

            // Auto rotation: 1 full rotation (Math.PI*2) every 20s
            if (!isHovered) {
                // Rotate around vertical Y axis
                surfaceGroup.rotation.y += ((Math.PI * 2) / 20) * delta;
            }

            renderer.render(scene, camera);
        }

        /* ── Handle Resize ── */
        function onWindowResize() {
            if (!container) return;
            const width = container.clientWidth;
            const height = container.clientHeight;

            if (width === 0 || height === 0) return; // Hidden on mobile

            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        }

        window.addEventListener("resize", onWindowResize);

        // Start
        animate();

        // Return cleanup function (though rarely needed in Astro generic scripts, good practice)
        return () => {
            cancelAnimationFrame(animId);
            window.removeEventListener("resize", onWindowResize);
            geometry.dispose();
            surfaceMat.dispose();
            wireMat.dispose();
            boxGeom.dispose();
            boxMat.dispose();
            renderer.dispose();
        };
    }

    // Wait for DOM
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initVolSurface);
    } else {
        initVolSurface();
    }
</script>
