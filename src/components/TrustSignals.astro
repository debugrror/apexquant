---
import BrandDivider from "./ui/BrandDivider.astro";
---

<section class="process" id="process">
    <div class="process-inner">
        <div class="process-header anim-process">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; 06 — HOW WE ENGAGE
            </span>
            <h2 class="process-headline">
                A Defined Engagement Model, From Discovery to Handover
            </h2>
        </div>

        <ol class="steps">
            <li class="step anim-process" style="transition-delay: 0.10s;">
                <span class="step-num">01</span>
                <h3 class="step-title">Discovery</h3>
                <p class="step-body">A structured technical session to map your current systems, constraints, and objectives.</p>
            </li>
            <li class="step anim-process" style="transition-delay: 0.22s;">
                <span class="step-num">02</span>
                <h3 class="step-title">Architecture</h3>
                <p class="step-body">A written design covering components, latency and risk budgets, and delivery milestones before code is written.</p>
            </li>
            <li class="step anim-process" style="transition-delay: 0.34s;">
                <span class="step-num">03</span>
                <h3 class="step-title">Build &amp; Validate</h3>
                <p class="step-body">Iterative delivery with code review, automated testing and, for trading systems, backtest and paper-trading validation.</p>
            </li>
            <li class="step anim-process" style="transition-delay: 0.46s;">
                <span class="step-num">04</span>
                <h3 class="step-title">Handover</h3>
                <p class="step-body">Documentation, knowledge transfer, and monitoring so your team can own and operate the system.</p>
            </li>
        </ol>

        <div class="platforms anim-process" style="transition-delay: 0.65s;">
            <span class="platforms-label font-mono-label">PLATFORMS WE BUILD ON</span>
            <ul class="platforms-list">
                <li class="partner-name" title="Amazon Web Services">AWS</li><li class="partner-name" title="Google Cloud Platform">Google Cloud</li><li class="partner-name" title="Microsoft Azure">Azure</li>
            </ul>
        </div>
    </div>

    <BrandDivider />
</section>

<script>
    const processSection = document.getElementById("process");
    if (processSection) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) entry.target.classList.add("visible");
                });
            },
            { threshold: 0.1 },
        );
        processSection
            .querySelectorAll(".anim-process")
            .forEach((el) => observer.observe(el));
    }
</script>

<style>
    .process {
        position: relative;
        padding: 7rem 1.5rem 0;
        background: var(--bg-primary);
        overflow: hidden;
    }
    .process-inner {
        max-width: 1200px;
        margin: 0 auto;
    }
    .process-header {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 3.5rem;
    }
    .process-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
        max-width: 640px;
    }

    .steps {
        list-style: none;
        margin: 0 0 4rem;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
    }
    .step {
        border-top: 1px solid var(--bg-elevated);
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .step-num {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.15em;
        color: var(--accent);
    }
    .step-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: -0.01em;
        color: var(--text-primary);
    }
    .step-body {
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.7;
    }

    .platforms {
        border-top: 1px solid var(--bg-elevated);
        padding: 2rem 0 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }
    .platforms-label {
        font-size: 0.6875rem;
        letter-spacing: 0.15em;
    }
    .platforms-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 3rem;
    }
    .partner-name {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1.125rem;
        letter-spacing: 0.03em;
        color: var(--text-primary);
    }

    /* Scroll reveal (transitions, so stagger via transition-delay) */
    .anim-process {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }
    .anim-process.visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 1024px) {
        .steps { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .process { padding: 5rem 1.25rem 0; }
        .steps { grid-template-columns: 1fr; gap: 1.75rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .anim-process {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
