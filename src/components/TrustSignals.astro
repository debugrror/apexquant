---
import BrandDivider from "./ui/BrandDivider.astro";
---

<section class="trust-signals" id="trust">
    <div class="trust-inner">
        <!-- Decorative section number -->
        <span class="section-number" aria-hidden="true">06</span>

        <!-- Header -->
        <div class="trust-header anim-trust-header">
            <span class="font-mono-label" style="color: var(--accent);">
                ◆&nbsp; TRUSTED BY
            </span>

            <h2 class="trust-headline">
                Trusted by Operators Who Cannot Afford to Be Wrong
            </h2>
        </div>

        <!-- Testimonial cards -->
        <div class="testimonials-grid">
            <!-- Testimonial 1 -->
            <blockquote
                class="testimonial-card anim-trust-card"
                style="animation-delay: 0s;"
            >
                <span class="quote-mark" aria-hidden="true">&ldquo;</span>
                <p class="quote-text">
                    The latency reduction <span class="brand-name"
                        >APEX QUANTS</span
                    > achieved on our order routing system was beyond what our internal
                    team considered feasible. They understand market microstructure
                    at a level that is rare.
                </p>
                <footer class="quote-author">
                    <span class="author-name">Head of Quantitative Trading</span
                    >
                    <span class="author-firm">Proprietary Trading Firm</span>
                </footer>
            </blockquote>

            <!-- Testimonial 2 -->
            <blockquote
                class="testimonial-card anim-trust-card"
                style="animation-delay: 0.15s;"
            >
                <span class="quote-mark" aria-hidden="true">&ldquo;</span>
                <p class="quote-text">
                    We brought them in to architect our risk management platform
                    from scratch. The system they delivered handles our full
                    book in real time with the reliability we required from day
                    one.
                </p>
                <footer class="quote-author">
                    <span class="author-name">CTO</span>
                    <span class="author-firm">Systematic Hedge Fund</span>
                </footer>
            </blockquote>
        </div>

        <!-- Placeholder honesty banner -->
        <div
            class="placeholder-banner anim-trust-card"
            style="animation-delay: 0.3s;"
        >
            <p>
                Real client testimonials coming soon — references available upon
                engagement.
            </p>
        </div>

        <!-- Stat callout bar -->
        <div
            class="stat-callout-bar anim-trust-stats"
            style="animation-delay: 0.35s;"
        >
            <div class="callout-stat">
                <span class="callout-value">50+</span>
                <span class="callout-label">Systems Architected</span>
            </div>
            <div class="callout-divider" aria-hidden="true"></div>
            <div class="callout-stat">
                <span class="callout-value">99.9%</span>
                <span class="callout-label">Uptime Delivered</span>
            </div>
            <div class="callout-divider" aria-hidden="true"></div>
            <div class="callout-stat">
                <span class="callout-value">&lt;5ms</span>
                <span class="callout-label">Latency Benchmarks</span>
            </div>
        </div>

        <!-- Infrastructure partners logos strip -->
        <div
            class="partners-section anim-trust-partners"
            style="animation-delay: 0.4s;"
        >
            <div class="partners-separator"></div>
            <span class="partners-label font-mono-label"
                >INFRASTRUCTURE PARTNERS</span
            >
            <div class="partners-logos">
                <!-- AWS -->
                <div class="partner-logo" title="Amazon Web Services">
                    <svg
                        viewBox="0 0 80 32"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        width="80"
                        height="32"
                    >
                        <text
                            x="0"
                            y="22"
                            font-family="var(--font-body)"
                            font-weight="600"
                            font-size="14"
                            fill="#CCCCCC"
                            letter-spacing="0.05em">AWS</text
                        >
                    </svg>
                </div>
                <!-- Google Cloud -->
                <div class="partner-logo" title="Google Cloud Platform">
                    <svg
                        viewBox="0 0 140 32"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        width="140"
                        height="32"
                    >
                        <text
                            x="0"
                            y="22"
                            font-family="var(--font-body)"
                            font-weight="600"
                            font-size="14"
                            fill="#CCCCCC"
                            letter-spacing="0.03em">Google Cloud</text
                        >
                    </svg>
                </div>
                <!-- Microsoft Azure -->
                <div class="partner-logo" title="Microsoft Azure">
                    <svg
                        viewBox="0 0 80 32"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        width="80"
                        height="32"
                    >
                        <text
                            x="0"
                            y="22"
                            font-family="var(--font-body)"
                            font-weight="600"
                            font-size="14"
                            fill="#CCCCCC"
                            letter-spacing="0.03em">Azure</text
                        >
                    </svg>
                </div>
                <!-- ISO 27001 -->
                <div class="partner-logo" title="ISO 27001 Ready">
                    <svg
                        viewBox="0 0 120 32"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        width="120"
                        height="32"
                    >
                        <text
                            x="0"
                            y="22"
                            font-family="var(--font-mono)"
                            font-weight="400"
                            font-size="12"
                            fill="#888888"
                            letter-spacing="0.05em">ISO 27001</text
                        >
                    </svg>
                </div>
                <!-- SOC 2 -->
                <div class="partner-logo" title="SOC 2 Aligned">
                    <svg
                        viewBox="0 0 80 32"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        width="80"
                        height="32"
                    >
                        <text
                            x="0"
                            y="22"
                            font-family="var(--font-mono)"
                            font-weight="400"
                            font-size="12"
                            fill="#888888"
                            letter-spacing="0.05em">SOC 2</text
                        >
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Brand divider -->
    <BrandDivider />
</section>

<!-- Scroll animation -->
<script>
    const trustSection = document.getElementById("trust");
    if (trustSection) {
        const targets = trustSection.querySelectorAll(
            ".anim-trust-header, .anim-trust-card, .anim-trust-stats, .anim-trust-partners",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .trust-signals {
        position: relative;
        padding: 7rem 1.5rem 0;
        background: var(--bg-primary);
        overflow: hidden;
    }

    .trust-inner {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Decorative section number ──────────────────────────── */
    .section-number {
        position: absolute;
        top: -1.5rem;
        left: -0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(6rem, 12vw, 10rem);
        color: #1a1a1a;
        line-height: 1;
        letter-spacing: -0.04em;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    /* ── Header ─────────────────────────────────────────────── */
    .trust-header {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .trust-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
        max-width: 640px;
    }

    /* ── Testimonial cards ──────────────────────────────────── */
    .testimonials-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .testimonial-card {
        position: relative;
        background: var(--bg-card);
        border-left: 3px solid var(--accent);
        padding: 2.25rem 2rem 2rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .quote-mark {
        font-family: var(--font-display);
        font-size: 4rem;
        line-height: 0.8;
        color: var(--accent);
        opacity: 0.6;
        user-select: none;
        position: absolute;
        top: 1rem;
        right: 1.5rem;
    }

    .quote-text {
        font-style: italic;
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--text-primary);
        max-width: 90%;
    }

    .quote-text .brand-name {
        font-style: normal;
        font-size: inherit;
    }

    .quote-author {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: auto;
    }

    .author-name {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--accent);
    }

    .author-firm {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--text-muted);
        letter-spacing: 0.02em;
    }

    /* ── Placeholder banner ─────────────────────────────────── */
    .placeholder-banner {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 0.875rem 1.5rem;
        border: 1px dashed rgba(168, 255, 0, 0.2);
        margin-bottom: 3rem;
    }

    .placeholder-banner p {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--text-muted);
        letter-spacing: 0.03em;
    }

    /* ── Stat callout bar ───────────────────────────────────── */
    .stat-callout-bar {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        padding: 2rem;
        border: 1px solid rgba(168, 255, 0, 0.12);
        background: rgba(168, 255, 0, 0.02);
        margin-bottom: 3rem;
    }

    .callout-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.375rem;
    }

    .callout-value {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        color: var(--accent);
        letter-spacing: -0.02em;
    }

    .callout-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .callout-divider {
        width: 1px;
        height: 40px;
        background: rgba(168, 255, 0, 0.15);
    }

    /* ── Partners logos strip ───────────────────────────────── */
    .partners-section {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        padding-bottom: 1rem;
    }

    .partners-separator {
        width: 100%;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(168, 255, 0, 0.1) 20%,
            rgba(168, 255, 0, 0.1) 80%,
            transparent 100%
        );
    }

    .partners-label {
        color: var(--text-muted) !important;
        font-size: 0.6875rem !important;
        letter-spacing: 0.15em !important;
    }

    .partners-logos {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        flex-wrap: wrap;
        opacity: 0.6;
    }

    .partner-logo {
        display: flex;
        align-items: center;
        transition: opacity 0.3s ease;
    }

    .partner-logo:hover {
        opacity: 0.8;
    }

    /* ── Scroll animations ──────────────────────────────────── */
    .anim-trust-header,
    .anim-trust-card,
    .anim-trust-stats,
    .anim-trust-partners {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.6s ease-out,
            transform 0.6s ease-out;
    }

    .anim-trust-header.visible,
    .anim-trust-card.visible,
    .anim-trust-stats.visible,
    .anim-trust-partners.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 768px) {
        .trust-signals {
            padding: 5rem 1.25rem 0;
        }

        .testimonials-grid {
            grid-template-columns: 1fr;
        }

        .stat-callout-bar {
            flex-direction: column;
            gap: 1.5rem;
        }

        .callout-divider {
            width: 40px;
            height: 1px;
        }

        .partners-logos {
            gap: 2rem;
        }

        .section-number {
            font-size: clamp(4rem, 20vw, 6rem);
            top: -1rem;
            left: -0.25rem;
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-trust-header,
        .anim-trust-card,
        .anim-trust-stats,
        .anim-trust-partners {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
