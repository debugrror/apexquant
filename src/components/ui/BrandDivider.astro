---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['brand-divider anim-divider', className]}>
  <span class="divider-line"></span>
  <span class="divider-symbol">✦</span>
  <span class="divider-line"></span>
</div>

<style>
  .brand-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2.5rem 0;
  }

  .divider-line {
    display: block;
    width: 80px;
    height: 1px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--divider-glow);
  }

  .divider-symbol {
    color: #FFFFFF;
    font-size: 0.75rem;
    line-height: 1;
  }
</style>
