---

---

<section class="contact-section" id="contact">
    <!-- Subtle Antigravity background image -->
    <div class="contact-bg" aria-hidden="true"></div>

    <div class="contact-inner">
        <div class="contact-grid">
            <!-- Left Column: Copy & Details -->
            <div class="contact-info anim-contact-left">
                <span
                    class="font-mono-label"
                    style="color: var(--accent); margin-bottom: 1rem; display: block;"
                >
                    ◆&nbsp; 07 — GET IN TOUCH
                </span>

                <h2 class="contact-headline">
                    Let's Architect Your Next System
                </h2>

                <div class="contact-body">
                    <p>
                        Whether you're scaling an existing trading
                        infrastructure, building a new AI-driven platform, or
                        modernising a legacy financial system — we begin every
                        engagement with a structured discovery session to scope
                        requirements and define a precise technical roadmap.
                    </p>
                    <p>
                        No sales calls. No generic proposals. Just senior
                        engineers and quant researchers who will assess your
                        actual problem.
                    </p>
                </div>

                <ul class="contact-details">
                    <li>
                        <!-- Lucide Mail -->
                        <svg
                            class="contact-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="2" y="4" width="20" height="16" rx="2"
                            ></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                            ></path>
                        </svg>
                        <a
                            href="mailto:info@apexquants.com"
                            class="contact-link">info@apexquants.com</a
                        >
                    </li>
                    <li>
                        <!-- Lucide Phone -->
                        <svg
                            class="contact-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path>
                        </svg>
                        <a href="tel:+919867724923" class="contact-link">+91 98677 24923</a>
                    </li>
                </ul>
            </div>

            <!-- Right Column: Contact Form -->
            <div class="contact-form-wrapper anim-contact-right">
                <!-- Same Formspree form the old PHP site used; host-agnostic (Vercel, nginx, anywhere) -->
                <form
                    class="contact-form"
                    name="contact"
                    method="POST"
                    action="https://formspree.io/f/myzdblog"
                >
                    <input type="hidden" name="_subject" value="New enquiry — apexquants.com" />
                    <!-- Formspree honeypot: submissions with _gotcha filled are dropped -->
                    <p class="hidden" style="display: none;">
                        <label
                            >Don't fill this out if you're human: <input
                                name="_gotcha"
                                tabindex="-1"
                                autocomplete="off"
                            /></label
                        >
                    </p>

                    <div class="form-group">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="company">Company (optional)</label>
                        <input
                            type="text"
                            id="company"
                            name="company"
                            placeholder="Company"
                        />
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@company.com"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            placeholder="Briefly describe your infrastructure needs..."
                            required></textarea>
                    </div>

                    <button type="submit" class="submit-btn font-mono-label"
                        >SUBMIT INQUIRY</button
                    >
                    <p class="form-note">
                        We use your details only to respond to your enquiry. See our
                        <a href="/privacy/">Privacy Policy</a>.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Scroll animation + progressive-enhancement form submit -->
<script>
    const form = document.querySelector<HTMLFormElement>(".contact-form");
    if (form) {
        form.noValidate = true; // JS shows its own errors; native validation stays for no-JS
        const msgs: Record<string, string> = {
            name: "Enter your name.",
            email: "Enter a valid email address.",
            message: "Enter a message.",
        };
        const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
            const old = document.getElementById(`${el.id}-error`);
            if (el.checkValidity()) {
                old?.remove();
                el.removeAttribute("aria-invalid");
                el.removeAttribute("aria-describedby");
                return true;
            }
            el.setAttribute("aria-invalid", "true");
            el.setAttribute("aria-describedby", `${el.id}-error`);
            if (!old) {
                const p = document.createElement("p");
                p.className = "field-error";
                p.id = `${el.id}-error`;
                p.textContent = msgs[el.id];
                el.after(p);
            }
            return false;
        };
        const fields = [
            ...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
                "input[required], textarea[required]",
            ),
        ];
        fields.forEach((el) => {
            el.addEventListener("blur", () => check(el));
            el.addEventListener("input", () => {
                if (el.hasAttribute("aria-invalid")) check(el);
            });
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const bad = fields.filter((el) => !check(el));
            if (bad.length) return bad[0].focus();

            const btn = form.querySelector<HTMLButtonElement>(".submit-btn")!;
            const label = btn.textContent;
            btn.disabled = true;
            btn.textContent = "SENDING…";
            form.querySelector(".form-error")?.remove();
            try {
                const res = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" },
                });
                if (!res.ok) throw new Error(String(res.status));
                const ok = document.createElement("div");
                ok.setAttribute("role", "status");
                ok.className = "form-success";
                ok.textContent =
                    "Thank you — your enquiry has been received. We'll reply to the email address you provided.";
                form.replaceWith(ok);
            } catch {
                const err = document.createElement("p");
                err.setAttribute("role", "alert");
                err.className = "form-error";
                err.innerHTML =
                    'Your message wasn\'t sent. Please try again or email <a href="mailto:info@apexquants.com">info@apexquants.com</a>.';
                btn.after(err);
                btn.disabled = false;
                btn.textContent = label;
            }
        });
    }

    const contactSection = document.getElementById("contact");
    if (contactSection) {
        const targets = contactSection.querySelectorAll(
            ".anim-contact-left, .anim-contact-right",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.15 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .contact-section {
        position: relative;
        padding: 7rem 1.5rem 8rem;
        background: var(--bg-primary); /* Base black */
        overflow: hidden;
    }

    /* ── Background Image ───────────────────────────────────── */
    .contact-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: url("/images/contact-bg.jpg");
        background-size: cover;
        background-position: center;
        opacity: 0.08; /* Very subtle as specified */
        pointer-events: none;
        mix-blend-mode: screen;
    }

    .contact-bg::after {
        /* Gradient overlay to ensure text readability */
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            var(--bg-primary) 0%,
            transparent 20%,
            transparent 80%,
            var(--bg-primary) 100%
        );
    }

    .contact-inner {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Grid Layout ────────────────────────────────────────── */
    .contact-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 5rem;
        align-items: start;
    }

    /* ── Left Column (Info) ─────────────────────────────────── */
    .contact-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
        margin-bottom: 2rem;
        max-width: 500px;
    }

    .contact-body {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 3rem;
        max-width: 540px;
    }

    .contact-body p {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--text-muted);
    }

    .contact-details {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact-details li {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .contact-icon {
        color: var(--accent);
        flex-shrink: 0;
    }

    .contact-link {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        color: var(--accent);
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .contact-link:hover {
        opacity: 0.8;
    }

    .contact-text-white {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        color: var(--text-primary);
    }

    /* ── Right Column (Form) ────────────────────────────────── */
    .contact-form-wrapper {
        background: transparent;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact-form label {
        display: block;
        margin-bottom: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .contact-form input,
    .contact-form textarea {
        width: 100%;
        background: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 0;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        padding: 0.875rem 1rem;
        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease;
        outline: none;
        -webkit-appearance: none; /* Removes native iOS styling */
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder {
        color: #8a8a8a;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 12px rgba(168, 255, 0, 0.15);
    }

    /* On-brand invalid state: white border + text message (no warm colours) */
    .contact-form [aria-invalid="true"] {
        border: 2px solid #ffffff;
        padding: calc(0.875rem - 1px) calc(1rem - 1px);
    }

    .contact-form :global(.field-error),
    .contact-form :global(.form-error) {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: #ffffff;
    }

    .contact-form :global(.form-error) {
        margin-top: 0;
        padding: 0.75rem 1rem;
        border: 2px solid #ffffff;
    }

    .contact-form :global(.form-error a) {
        color: var(--accent);
        text-decoration: underline;
    }

    .contact-form-wrapper :global(.form-success) {
        padding: 1.5rem;
        border: 1px solid var(--accent);
        color: #ffffff;
        font-size: 1.0625rem;
        line-height: 1.6;
    }

    .form-note {
        font-size: 0.8125rem;
        color: var(--text-muted);
        margin: 0;
    }

    .form-note a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .form-note a:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
    }

    .submit-btn:disabled {
        opacity: 0.7;
        cursor: wait;
    }

    .contact-form textarea {
        resize: vertical;
        min-height: 120px;
    }

    .submit-btn {
        width: 100%;
        background: var(--accent);
        color: #050505; /* Black text */
        border: none;
        border-radius: 0; /* No border-radius */
        padding: 1.125rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color 0.3s ease,
            transform 0.2s ease;
        margin-top: 0.5rem;
    }

    .submit-btn:hover {
        background: #c8ff40; /* Slightly brighter green hover */
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    /* ── Scroll Animations ──────────────────────────────────── */
    .anim-contact-left {
        opacity: 0;
        transform: translateX(-30px);
        transition:
            opacity 0.7s ease-out,
            transform 0.7s ease-out;
    }

    .anim-contact-right {
        opacity: 0;
        transform: translateX(30px);
        transition:
            opacity 0.7s ease-out 0.2s,
            transform 0.7s ease-out 0.2s;
    }

    .anim-contact-left.visible,
    .anim-contact-right.visible {
        opacity: 1;
        transform: translateX(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .contact-grid {
            gap: 3rem;
        }
    }

    @media (max-width: 768px) {
        .contact-section {
            padding: 5rem 1.25rem 6rem;
        }

        .contact-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .contact-body {
            margin-bottom: 2rem;
        }

        .anim-contact-right {
            transition-delay: 0s;
            transform: translateY(30px);
        }

        .anim-contact-left {
            transform: translateY(30px);
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-contact-left,
        .anim-contact-right {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
