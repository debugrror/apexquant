---

---

<section class="contact-section" id="contact">
    <!-- Subtle Antigravity background image -->
    <div class="contact-bg" aria-hidden="true"></div>

    <div class="contact-inner">
        <!-- Decorative section number -->
        <span class="section-number" aria-hidden="true">07</span>

        <div class="contact-grid">
            <!-- Left Column: Copy & Details -->
            <div class="contact-info anim-contact-left">
                <span
                    class="font-mono-label"
                    style="color: var(--accent); margin-bottom: 1rem; display: block;"
                >
                    ◆&nbsp; GET IN TOUCH
                </span>

                <h2 class="contact-headline">
                    Let's Architect Your Next System
                </h2>

                <div class="contact-body">
                    <p>
                        Whether you're scaling an existing trading
                        infrastructure, building a new AI-driven platform, or
                        modernising a legacy financial system — we begin every
                        engagement with a structured discovery session to scope
                        requirements and define a precise technical roadmap.
                    </p>
                    <p>
                        No sales calls. No generic proposals. Just senior
                        engineers and quant researchers who will assess your
                        actual problem.
                    </p>
                </div>

                <ul class="contact-details">
                    <li>
                        <!-- Lucide Globe -->
                        <svg
                            class="contact-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path
                                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                            ></path>
                        </svg>
                        <a
                            href="https://www.apexquants.com"
                            class="contact-link">www.apexquants.com</a
                        >
                    </li>
                    <li>
                        <!-- Lucide Mail -->
                        <svg
                            class="contact-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="2" y="4" width="20" height="16" rx="2"
                            ></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                            ></path>
                        </svg>
                        <a
                            href="mailto:info@apexquants.com"
                            class="contact-link">info@apexquants.com</a
                        >
                    </li>
                    <li>
                        <!-- Lucide Phone -->
                        <svg
                            class="contact-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path>
                        </svg>
                        <span class="contact-text-white">+91 986-772-4923</span>
                    </li>
                </ul>
            </div>

            <!-- Right Column: Contact Form -->
            <div class="contact-form-wrapper anim-contact-right">
                <!-- Formspree fallback: action="https://formspree.io/f/your_id" method="POST" -->
                <form
                    class="contact-form"
                    name="contact"
                    method="POST"
                    data-netlify="true"
                    netlify-honeypot="bot-field"
                >
                    <input type="hidden" name="form-name" value="contact" />
                    <p class="hidden" style="display: none;">
                        <label
                            >Don't fill this out if you're human: <input
                                name="bot-field"
                            /></label
                        >
                    </p>

                    <div class="form-group">
                        <label for="name" class="sr-only">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="company" class="sr-only">Company</label>
                        <input
                            type="text"
                            id="company"
                            name="company"
                            placeholder="Company"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="email" class="sr-only">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Email Address"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="message" class="sr-only">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            placeholder="Briefly describe your infrastructure needs..."
                            required></textarea>
                    </div>

                    <button type="submit" class="submit-btn font-mono-label"
                        >SUBMIT INQUIRY</button
                    >
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Scroll animation -->
<script>
    const contactSection = document.getElementById("contact");
    if (contactSection) {
        const targets = contactSection.querySelectorAll(
            ".anim-contact-left, .anim-contact-right",
        );

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.15 },
        );

        targets.forEach((el) => observer.observe(el));
    }
</script>

<style>
    .contact-section {
        position: relative;
        padding: 7rem 1.5rem 8rem;
        background: var(--bg-primary); /* Base black */
        overflow: hidden;
    }

    /* ── Background Image ───────────────────────────────────── */
    .contact-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: url("/images/contact-bg.png");
        background-size: cover;
        background-position: center;
        opacity: 0.08; /* Very subtle as specified */
        pointer-events: none;
        mix-blend-mode: screen;
    }

    .contact-bg::after {
        /* Gradient overlay to ensure text readability */
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            var(--bg-primary) 0%,
            transparent 20%,
            transparent 80%,
            var(--bg-primary) 100%
        );
    }

    .contact-inner {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Decorative section number ──────────────────────────── */
    .section-number {
        position: absolute;
        top: -2.5rem;
        left: -0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(6rem, 12vw, 10rem);
        color: #1a1a1a;
        line-height: 1;
        letter-spacing: -0.04em;
        pointer-events: none;
        user-select: none;
        z-index: -1;
    }

    /* ── Grid Layout ────────────────────────────────────────── */
    .contact-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 5rem;
        align-items: start;
    }

    /* ── Left Column (Info) ─────────────────────────────────── */
    .contact-headline {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text-primary);
        margin-bottom: 2rem;
        max-width: 500px;
    }

    .contact-body {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 3rem;
        max-width: 540px;
    }

    .contact-body p {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--text-muted);
    }

    .contact-details {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact-details li {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .contact-icon {
        color: var(--accent);
        flex-shrink: 0;
    }

    .contact-link {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        color: var(--accent);
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .contact-link:hover {
        opacity: 0.8;
    }

    .contact-text-white {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        color: var(--text-primary);
    }

    /* ── Right Column (Form) ────────────────────────────────── */
    .contact-form-wrapper {
        background: transparent;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .contact-form input,
    .contact-form textarea {
        width: 100%;
        background: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 0;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        padding: 0.875rem 1rem;
        transition:
            border-color 0.3s ease,
            box-shadow 0.3s ease;
        outline: none;
        -webkit-appearance: none; /* Removes native iOS styling */
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder {
        color: #666666;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 12px rgba(168, 255, 0, 0.15);
    }

    /* Override native HTML5 validation red box-shadow in some browsers */
    .contact-form input:invalid:not(:focus):not(:placeholder-shown),
    .contact-form textarea:invalid:not(:focus):not(:placeholder-shown) {
        box-shadow: none;
        border-color: #ff3333;
    }

    .contact-form textarea {
        resize: vertical;
        min-height: 120px;
    }

    .submit-btn {
        width: 100%;
        background: var(--accent);
        color: #050505; /* Black text */
        border: none;
        border-radius: 0; /* No border-radius */
        padding: 1.125rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color 0.3s ease,
            transform 0.2s ease;
        margin-top: 0.5rem;
    }

    .submit-btn:hover {
        background: #c8ff40; /* Slightly brighter green hover */
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    /* ── Scroll Animations ──────────────────────────────────── */
    .anim-contact-left {
        opacity: 0;
        transform: translateX(-30px);
        transition:
            opacity 0.7s ease-out,
            transform 0.7s ease-out;
    }

    .anim-contact-right {
        opacity: 0;
        transform: translateX(30px);
        transition:
            opacity 0.7s ease-out 0.2s,
            transform 0.7s ease-out 0.2s;
    }

    .anim-contact-left.visible,
    .anim-contact-right.visible {
        opacity: 1;
        transform: translateX(0);
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .contact-grid {
            gap: 3rem;
        }
    }

    @media (max-width: 768px) {
        .contact-section {
            padding: 5rem 1.25rem 6rem;
        }

        .contact-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .section-number {
            font-size: clamp(4rem, 20vw, 6rem);
            top: -1.5rem;
            left: -0.25rem;
        }

        .contact-body {
            margin-bottom: 2rem;
        }

        .anim-contact-right {
            transition-delay: 0s;
            transform: translateY(30px);
        }

        .anim-contact-left {
            transform: translateY(30px);
        }
    }

    /* ── Prefers reduced motion ─────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .anim-contact-left,
        .anim-contact-right {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>
